# Environment template — copy to .env and fill locally / in hosting secrets.
# Never commit real API keys, database passwords, or production SECRET_KEY values.

FLASK_DEBUG=0
PORT=8080
OFFICIAL_URL=https://twodaymovie.onrender.com/
SECRET_KEY=
# Required for the optional Compose monitoring stack; generate a unique password.
GRAFANA_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Free / public APIs used by 2daymovie
# ---------------------------------------------------------------------------
# TMDB (The Movie Database) — free API key from https://www.themoviedb.org/settings/api
# Used for: trailers metadata, cast, similar titles, and legal watch providers.
# Without TMDB_API_KEY the curated offline catalog still works (trailers only).
TMDB_API_KEY=
TMDB_WATCH_REGION=US

# YouTube embeds: official trailers only (no API key required for iframe embeds).
# Images CDN: https://image.tmdb.org (public poster/backdrop assets).

# ---------------------------------------------------------------------------
# Optional production reviews store (Neon / Supabase Postgres)
# Prefer setting DATABASE_URL on Render. Locally you may use:
#   data/official_database.url
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# OFFICIAL_DATABASE_URL_FILE=data/official_database.url

# Gunicorn (Docker / K8s)
WEB_CONCURRENCY=2
WEB_THREADS=4

# Static export / GitHub Pages
# BASE_PATH=/2daymovie
# STATIC_EXPORT=0
# REVIEWS_LOCAL_ONLY=1
