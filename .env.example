# Environment template — copy to .env and fill secrets locally / in CI.
# Never commit real API keys.

FLASK_DEBUG=0
PORT=8080
OFFICIAL_URL=https://twodaymovie.onrender.com/
SECRET_KEY=change-me-in-production

# Optional persistent path for visitor reviews (defaults to data/reviews.json)
# REVIEWS_PATH=/var/data/reviews.json

# TMDB API key (optional locally; demo catalog still works without it)
TMDB_API_KEY=
TMDB_WATCH_REGION=US

# Gunicorn (Docker / K8s)
WEB_CONCURRENCY=2
WEB_THREADS=4
