# Environment template: copy to .env for local runs. Never commit real secrets.
FLASK_DEBUG=0
PORT=8080

# The catalog is plain JSON (data/catalog.json, data/trailers.json) built with
# yt-dlp by scripts/build_catalog.py and scripts/build_trailers.py.
# No API keys are needed; every title plays through the official YouTube embed.

# Gunicorn (Docker / K8s)
WEB_CONCURRENCY=2
WEB_THREADS=4
