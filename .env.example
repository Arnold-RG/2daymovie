# Environment template — copy to .env and fill secrets locally / in CI.
# Never commit real API keys.

FLASK_DEBUG=0
PORT=8080
OFFICIAL_URL=https://twodaymovie.onrender.com/
SECRET_KEY=change-me-in-production

# Production reviews: Postgres connection string (Neon / Supabase recommended).
# Without this, local/dev uses SQLite at data/reviews.db
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional local SQLite override
# REVIEWS_SQLITE_PATH=data/reviews.db

# TMDB API key (optional locally; demo catalog still works without it)
TMDB_API_KEY=
TMDB_WATCH_REGION=US

# Gunicorn (Docker / K8s)
WEB_CONCURRENCY=2
WEB_THREADS=4
